# THEIA / KHEPRI environment variables
# Copy to .env and populate before running the server.
# Never commit .env to version control.

# ── Supabase (KHEPRI Witness Store) ──────────────────────────────────────────
# Project URL — from Supabase dashboard → Settings → API
SUPABASE_URL=https://<your-ref>.supabase.co

# Service-role key — NOT the anon key.
# Required so KHEPRI can write to RLS-protected tables.
SUPABASE_SERVICE_KEY=<your-service-role-key>

# ── THEIA server ──────────────────────────────────────────────────────────────
PORT=7704
ENV=production
LOG_LEVEL=INFO
